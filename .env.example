# === LLM credentials ===
# Mistral API key used for clustering insights; replace with real key before running the stack.
MISTRAL_API_KEY=your-mistral-api-key

# === Feed configuration ===
# Default NOS RSS feed for general news headlines.
RSS_NOS_URL=https://feeds.nos.nl/nosnieuwsalgemeen
# Default NU.nl RSS feed for binnenland nieuws.
RSS_NUNL_URL=https://www.nu.nl/rss/Algemeen

# === Scheduler cadence ===
# Interval (in minutes) for the ingest scheduler job.
SCHEDULER_INTERVAL_MINUTES=15

# === Persistence ===
# SQLAlchemy connection string; keep SQLite for local MVP.
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Supabase PostgreSQL (production)
# Get these credentials from your Supabase project dashboard:
# Project Settings → Database → Connection String (Direct)
# Replace YOUR_PASSWORD with your actual database password
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Connections of the backend. The Supabase pooler (session mode) allows 15 clients for the whole
# project; keep pool size + overflow below that, else it refuses connections (EMAXCONNSESSION).
# DATABASE_POOL_SIZE=6
# DATABASE_MAX_OVERFLOW=6

# === NLP and LLM settings ===
# Embedding model identifier used by sentence-transformers.
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# Dimensionality of the embedding vectors produced by the selected model.
EMBEDDING_DIMENSION=384
# Directory for caching embeddings, TF-IDF models, etc.
MODEL_CACHE_DIR=./data/models
# Cached TF-IDF vectorizer path; regenerate automatically when missing.
TFIDF_CACHE_PATH=./data/models/tfidf_vectorizer.joblib
# Maximum number of terms retained by the TF-IDF vectorizer.
TFIDF_MAX_FEATURES=6000
# spaCy model used for Dutch preprocessing and NER.
SPACY_MODEL_NAME=nl_core_news_lg
# Active LLM provider slug (e.g. mistral, openai); adapter uses this value.
LLM_PROVIDER=mistral
# Maximum number of articles included when building an LLM prompt (tune for quality vs. cost).
LLM_PROMPT_ARTICLE_CAP=8
# Hard character limit for the generated prompt (guards against token explosions).
LLM_PROMPT_MAX_CHARACTERS=15000
# Default model name used when calling the LLM provider (Mistral by default).
LLM_MODEL_NAME=mistral-small-latest
# Temperature applied to insight generation calls (0 keeps responses deterministic).
LLM_TEMPERATURE=0.2
# Base URL for the configured LLM API; keep default for hosted Mistral.
LLM_API_BASE_URL=https://api.mistral.ai/v1
# Request timeout for LLM calls (seconds).
LLM_API_TIMEOUT_SECONDS=45
# Retry attempts and base delay for transient LLM errors.
LLM_API_MAX_RETRIES=3
LLM_API_RETRY_BACKOFF_SECONDS=2

# === Event detection / vector index ===
# Location of the persisted hnswlib index file.
VECTOR_INDEX_PATH=./data/vector_index.bin
# Metadata JSON saved alongside the index with parameter integrity information.
VECTOR_INDEX_METADATA_PATH=./data/vector_index.meta.json
# Initial capacity for the vector index (resize automatically when needed).
VECTOR_INDEX_MAX_ELEMENTS=20000
# hnswlib hyperparameters tuning accuracy/latency of the index.
VECTOR_INDEX_M=16
VECTOR_INDEX_EF_CONSTRUCTION=200
VECTOR_INDEX_EF_SEARCH=64
# Candidate retrieval defaults.
EVENT_CANDIDATE_TOP_K=10
EVENT_CANDIDATE_TIME_WINDOW_DAYS=7
# Event lifecycle configuration (archiving + maintenance).
EVENT_RETENTION_DAYS=14
EVENT_MAINTENANCE_INTERVAL_HOURS=24
EVENT_INDEX_REBUILD_ON_DRIFT=true
# Storage rule: maintenance clears vectors of archived news and raw LLM responses after N days.
STORAGE_PRUNE_ENABLED=true
RAW_LLM_RESPONSE_RETENTION_DAYS=7
# Hybrid scoring weights and thresholds for event assignment.
# Higher entity weight: persons and locations are key identity markers
EVENT_SCORE_WEIGHT_EMBEDDING=0.50
EVENT_SCORE_WEIGHT_TFIDF=0.25
EVENT_SCORE_WEIGHT_ENTITIES=0.25
EVENT_SCORE_THRESHOLD=0.60
# Faster time decay: breaking news clusters within 24h
EVENT_SCORE_TIME_DECAY_HALF_LIFE_HOURS=24
EVENT_SCORE_TIME_DECAY_FLOOR=0.25

# Enable LLM-based final decision for event clustering (uses Mistral to choose from top candidates)
EVENT_LLM_ENABLED=true
# Number of top-scoring candidates to present to LLM for decision
EVENT_LLM_TOP_N=2
# Minimum score required for a candidate to be presented to LLM
EVENT_LLM_MIN_SCORE=0.55

# === Onderzoeksmodus / exploration (Epic 11, Story 11.8) ===
# Precompute canonical entities (event_entities) and related events (event_relations).
EXPLORATION_ENABLED=true
# Maximum number of canonical entities stored per event.
EXPLORATION_ENTITIES_MAX_PER_EVENT=40
# Related events: keep at most TOP_K rows per event with score >= MIN_SCORE.
RELATED_EVENTS_TOP_K=12
RELATED_EVENTS_MIN_SCORE=0.30
# Relation score = w_emb * centroid cosine + w_ent * entity overlap + w_cty * country overlap.
RELATED_EVENTS_WEIGHT_EMBEDDING=0.55
RELATED_EVENTS_WEIGHT_ENTITIES=0.35
RELATED_EVENTS_WEIGHT_COUNTRIES=0.10
# Timeout (seconds) for the exploration refresh that runs after the daily event maintenance.
EXPLORATION_REFRESH_TIMEOUT_SECONDS=300

# === Propagandamodel-koppeling (Epic 11, Story 11.17) ===
# Read-only sync of the approved propaganda-model graph to the pm_* tables (Supabase access only
# via the RPC functions of database/migrations/005_propagandamodel.sql - run it first).
# Path to the propaganda-model SQLite database; relative paths are resolved from the repository
# root, empty = the sibling default ../propaganda-model/data/propaganda_model.db
PROPAGANDA_DB_PATH=
PROPAGANDA_SYNC_ENABLED=true
# Interval of the sync job; it only writes when the database file (or its WAL) changed.
PROPAGANDA_SYNC_INTERVAL_MINUTES=60

# === Wie is dit? (Epic 12) - research of names in the news by the propaganda-model agents ===
# Triage names (role + importance), queue research targets in the propaganda model
# (POST /api/nieuws/doelen, account nieuws-agent), start rounds of its agent nieuws-scout and
# pull the results. Requires database/migrations/006_entity_research.sql and a running
# propaganda-model server. Private persons are never researched.
ENTITY_RESEARCH_ENABLED=true
ENTITY_RESEARCH_INTERVAL_MINUTES=15
ENTITY_RESEARCH_LOOKBACK_DAYS=7
# Names with fewer approved relations in the propaganda model are researched
ENTITY_RESEARCH_MIN_PM_RELATIONS=3
ENTITY_RESEARCH_AUTO_THRESHOLD=60
# Daily budgets: automatic targets and targets from taps in the app
ENTITY_RESEARCH_DAILY_TARGETS=12
ENTITY_RESEARCH_DAILY_REQUESTS=30
ENTITY_RESEARCH_COOLDOWN_DAYS=30
# 127.0.0.1, not localhost (macOS: ::1:5000 belongs to the AirPlay receiver)
PM_API_BASE_URL=http://127.0.0.1:5000
# Empty = <propaganda-model>/data/tokens/nieuws-agent.token
PM_AGENT_TOKEN_PATH=
# Research rounds (each round is a Claude session of ~10 minutes: mind your usage)
NIEUWS_SCOUT_ENABLED=true
NIEUWS_SCOUT_MAX_ROUNDS_PER_DAY=4
NIEUWS_SCOUT_MIN_MINUTES_BETWEEN_ROUNDS=30
NIEUWS_SCOUT_ACTIVE_START_HOUR=8
NIEUWS_SCOUT_ACTIVE_END_HOUR=22
NIEUWS_SCOUT_MODEL=opus
NIEUWS_SCOUT_EFFORT=high
# Run the propaganda model's auto-approval after a round (owner decision 2026-09-30; the
# propaganda model has its own gates and kill switch PROPAGANDA_NIEUWS_AUTOKEUR=0)
PM_AUTOKEUR_ENABLED=true

# === Foreign article digest ("Wat schreef …?") ===
# Google News only gives a foreign article's headline: this job fetches the text from the publisher
# and stores a Dutch gist by the LLM in source_metadata.digest (the text itself is not stored).
# Provider: llm_config key provider_digest, else the provider of the factual analysis.
ARTICLE_DIGEST_ENABLED=true
ARTICLE_DIGEST_INTERVAL_MINUTES=15
ARTICLE_DIGEST_BATCH_SIZE=10
# The job only takes articles of the last N hours; older ones via POST /admin/trigger/article-digests
ARTICLE_DIGEST_MAX_AGE_HOURS=72
ARTICLE_DIGEST_TEXT_CHARS=6000

# === Local SQLite Cache (INFRA-1: Egress Optimization) ===
# Where backend reads data from: 'sqlite' (local cache) or 'supabase' (cloud)
# Use 'sqlite' on production PC (zero egress), 'supabase' on dev laptop
BACKEND_READ_SOURCE=supabase
# Path to local SQLite cache database
SQLITE_CACHE_PATH=data/local_cache.db

# === Observability ===
# Global logging level for backend services.
LOG_LEVEL=INFO
